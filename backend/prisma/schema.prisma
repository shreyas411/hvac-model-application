generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Conventions (TECH_SPEC §4): uuid ids, legacy_id keeps old frontend ids for import,
// money numeric(12,2), dates `date`. Times stay "HH:MM" text like the API types.
// ponytail: start/end times as text, switch to time + exclusion constraint if DB-level conflict guard is wanted (§6.3).

enum UserRole {
  admin
  dispatcher
  technician
  accountant
}

enum CustomerType {
  residential
  commercial
  landlord
}

enum CommunicationPreference {
  email
  sms
  both
}

enum EquipmentType {
  combi_boiler
  system_boiler
  heat_pump
  air_conditioning
  ventilation
  chiller
}

enum MaintenanceFrequency {
  quarterly
  biannual
  annual
}

enum EquipmentStatus {
  operational
  requires_attention
  decommissioned
}

enum Priority {
  low
  medium
  high
  emergency
}

enum PreferredSlot {
  morning
  afternoon
  all_day
  urgent
}

enum ServiceRequestStatus {
  new
  awaiting_approval
  converted
  cancelled
}

enum JobType {
  installation
  repair
  inspection
  emergency_callout
  preventive_maintenance
}

enum JobStatus {
  new
  awaiting_approval
  scheduled
  dispatched
  in_progress
  on_hold
  completed
  cancelled
}

enum ChecklistCategory {
  gas_safety
  electrical
  refrigerant
  general
}

enum QuotationStatus {
  draft
  sent
  viewed
  accepted
  rejected
  expired
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  void
  credited
}

enum LineItemType {
  labour
  part
  equipment
  travel
  discount
  fee
}

enum PaymentMethod {
  bacs
  card
  cheque
  cash
}

enum MovementType {
  used_on_job
  stock_adjustment
  restock_purchase
}

enum CertificateType {
  cp12
  service_record
  commissioning
}

enum NotificationType {
  booking_confirmation
  appointment_reminder
  technician_arriving
  quotation_ready
  invoice_issued
  payment_reminder
}

enum NotificationChannel {
  email
  sms
}

enum NotificationStatus {
  draft
  ready_to_send
  sending
  sent
  failed
}

model User {
  // = auth.users.id (Supabase Auth); no default on purpose
  id           String      @id @db.Uuid
  companyId    String      @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company      Company     @relation(fields: [companyId], references: [id])
  name         String
  email        String
  password     String?     @map("password")
  role         UserRole
  phone        String      @default("")
  avatar       String?
  technicianId String?     @unique @map("technician_id") @db.Uuid
  technician   Technician? @relation(fields: [technicianId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  isDeleted    Boolean     @default(false) @map("is_deleted")
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz
  inactive     Boolean     @default(false)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model Technician {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id])
  legacyId        String?   @map("legacy_id")
  name            String
  phone           String    @default("")
  email           String    @default("")
  gasSafeLicense  String?   @map("gas_safe_license")
  fGasLicense     String?   @map("f_gas_license")
  gasSafeExpiry   DateTime? @map("gas_safe_expiry") @db.Date
  fGasExpiry      DateTime? @map("f_gas_expiry") @db.Date
  skills          String[]
  color           String
  active          Boolean   @default(true)
  vanRegistration String?   @map("van_registration")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User?
  jobs Job[]

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@map("technicians")
}

// One row per company
model CompanySettings {
  companyId           String    @id @map("company_id") @db.Uuid
  company             Company   @relation(fields: [companyId], references: [id])
  companyName         String    @map("company_name")
  tradingName         String    @default("") @map("trading_name")
  gasSafeRegisterNo   String    @default("") @map("gas_safe_register_no")
  fGasCertNo          String    @default("") @map("f_gas_cert_no")
  vatNumber           String    @default("") @map("vat_number")
  companyNumber       String    @default("") @map("company_number")
  email               String    @default("")
  phone               String    @default("")
  addressLine1        String    @default("") @map("address_line1")
  city                String    @default("")
  postcode            String    @default("")
  website             String    @default("")
  currencySymbol      String    @default("£") @map("currency_symbol")
  defaultVatRate      Decimal   @default(20) @map("default_vat_rate") @db.Decimal(5, 2)
  defaultHourlyRate   Decimal   @default(85) @map("default_hourly_rate") @db.Decimal(12, 2)
  defaultTravelCharge Decimal   @default(35) @map("default_travel_charge") @db.Decimal(12, 2)
  availableVatRates   Decimal[] @map("available_vat_rates") @db.Decimal(5, 2)
  workingHoursStart   String    @default("08:00") @map("working_hours_start")
  workingHoursEnd     String    @default("17:30") @map("working_hours_end")
  enableInventory     Boolean   @default(true) @map("enable_inventory")
  autoSendEmails      Boolean   @default(false) @map("auto_send_emails") // true: customer emails go out without staff approval
  prefixJob           String    @default("JOB-") @map("prefix_job")
  prefixQuote         String    @default("QTE-") @map("prefix_quote")
  prefixInvoice       String    @default("INV-") @map("prefix_invoice")
  bankDetails         Json      @default("{}") @map("bank_details")
  termsAndConditions  String    @default("") @map("terms_and_conditions")
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("company_settings")
}

// Document numbering (§6.1): UPDATE ... SET next_value = next_value + 1 RETURNING inside the create tx
model Counter {
  companyId String  @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  year      Int
  nextValue Int     @default(1) @map("next_value")

  @@id([companyId, key, year])
  @@map("counters")
}

model Customer {
  id                      String                  @id @default(uuid()) @db.Uuid
  companyId               String                  @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company                 Company                 @relation(fields: [companyId], references: [id])
  legacyId                String?                 @map("legacy_id")
  type                    CustomerType
  name                    String
  companyName             String?                 @map("company_name")
  phone                   String                  @default("")
  email                   String                  @default("")
  billingAddress          Json                    @map("billing_address")
  notes                   String?
  communicationPreference CommunicationPreference @default(email) @map("communication_preference")
  gdprConsent             Boolean                 @default(false) @map("gdpr_consent")
  archived                Boolean                 @default(false)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz
  isDeleted               Boolean                 @default(false) @map("is_deleted")
  deletedAt               DateTime?               @map("deleted_at") @db.Timestamptz
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  locations     ServiceLocation[]
  equipment     Equipment[]
  requests      ServiceRequest[]
  jobs          Job[]
  quotations    Quotation[]
  invoices      Invoice[]
  notifications Notification[]

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@map("customers")
}

model ServiceLocation {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id])
  legacyId     String?   @map("legacy_id")
  customerId   String    @map("customer_id") @db.Uuid
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String
  addressLine1 String    @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String
  postcode     String
  accessNotes  String?   @map("access_notes")
  contactName  String?   @map("contact_name")
  contactPhone String?   @map("contact_phone")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  inactive     Boolean   @default(false)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  equipment  Equipment[]
  requests   ServiceRequest[]
  jobs       Job[]
  quotations Quotation[]
  invoices   Invoice[]

  @@unique([companyId, legacyId])
  @@index([customerId])
  @@index([companyId])
  @@map("service_locations")
}

model Equipment {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company              Company              @relation(fields: [companyId], references: [id])
  legacyId             String?              @map("legacy_id")
  customerId           String               @map("customer_id") @db.Uuid
  customer             Customer             @relation(fields: [customerId], references: [id])
  locationId           String               @map("location_id") @db.Uuid
  location             ServiceLocation      @relation(fields: [locationId], references: [id])
  type                 EquipmentType
  brand                String
  model                String
  serialNumber         String               @default("") @map("serial_number")
  refrigerantType      String?              @map("refrigerant_type")
  refrigerantChargeKg  Float?               @map("refrigerant_charge_kg")
  installationDate     DateTime?            @map("installation_date") @db.Date
  warrantyExpiryDate   DateTime?            @map("warranty_expiry_date") @db.Date
  maintenanceFrequency MaintenanceFrequency @map("maintenance_frequency")
  lastServiceDate      DateTime?            @map("last_service_date") @db.Date
  nextServiceDueDate   DateTime?            @map("next_service_due_date") @db.Date
  status               EquipmentStatus      @default(operational)
  locationNotes        String?              @map("location_notes")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  isDeleted            Boolean              @default(false) @map("is_deleted")
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamptz
  inactive             Boolean              @default(false)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  serviceRecords EquipmentServiceRecord[]
  requests       ServiceRequest[]
  jobs           JobEquipment[]

  @@unique([companyId, legacyId])
  @@index([customerId])
  @@index([nextServiceDueDate])
  @@index([companyId])
  @@map("equipment")
}

model EquipmentServiceRecord {
  id              String    @id @default(uuid()) @db.Uuid
  legacyId        String?   @unique @map("legacy_id")
  equipmentId     String    @map("equipment_id") @db.Uuid
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date            DateTime  @db.Date
  jobId           String?   @map("job_id") @db.Uuid
  job             Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  technicianName  String    @map("technician_name")
  serviceType     String    @map("service_type")
  findings        String    @default("")
  readings        Json?
  partsReplaced   String[]  @map("parts_replaced")
  recommendations String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([equipmentId])
  @@map("equipment_service_records")
}

model ServiceRequest {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company         Company              @relation(fields: [companyId], references: [id])
  legacyId        String?              @map("legacy_id")
  requestNumber   String               @map("request_number")
  customerId      String               @map("customer_id") @db.Uuid
  customer        Customer             @relation(fields: [customerId], references: [id])
  locationId      String               @map("location_id") @db.Uuid
  location        ServiceLocation      @relation(fields: [locationId], references: [id])
  equipmentId     String?              @map("equipment_id") @db.Uuid
  equipment       Equipment?           @relation(fields: [equipmentId], references: [id])
  reportedProblem String               @map("reported_problem")
  priority        Priority             @default(medium)
  preferredSlot   PreferredSlot        @default(morning) @map("preferred_slot")
  status          ServiceRequestStatus @default(new)
  contactPerson   String?              @map("contact_person")
  contactPhone    String?              @map("contact_phone")
  internalNotes   String?              @map("internal_notes")
  convertedJobId  String?              @unique @map("converted_job_id") @db.Uuid
  convertedJob    Job?                 @relation("RequestConvertedJob", fields: [convertedJobId], references: [id])
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  isDeleted       Boolean              @default(false) @map("is_deleted")
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  jobs Job[] @relation("JobRequest")

  @@unique([companyId, legacyId])
  @@unique([companyId, requestNumber])
  @@index([status])
  @@index([companyId])
  @@map("service_requests")
}

model Job {
  id                       String          @id @default(uuid()) @db.Uuid
  companyId                String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company                  Company         @relation(fields: [companyId], references: [id])
  legacyId                 String?         @map("legacy_id")
  jobNumber                String          @map("job_number")
  requestId                String?         @map("request_id") @db.Uuid
  request                  ServiceRequest? @relation("JobRequest", fields: [requestId], references: [id])
  customerId               String          @map("customer_id") @db.Uuid
  customer                 Customer        @relation(fields: [customerId], references: [id])
  locationId               String          @map("location_id") @db.Uuid
  location                 ServiceLocation @relation(fields: [locationId], references: [id])
  type                     JobType
  priority                 Priority        @default(medium)
  status                   JobStatus       @default(new)
  technicianId             String?         @map("technician_id") @db.Uuid
  technician               Technician?     @relation(fields: [technicianId], references: [id])
  appointmentDate          DateTime        @map("appointment_date") @db.Date
  startTime                String          @map("start_time")
  endTime                  String          @map("end_time")
  estimatedDurationMinutes Int             @default(60) @map("estimated_duration_minutes")
  requiredSkills           String[]        @map("required_skills")
  title                    String          @default("")
  description              String          @default("")
  internalNotes            String?         @map("internal_notes")
  workPerformed            String?         @map("work_performed")
  labourHours              Decimal         @default(0) @map("labour_hours") @db.Decimal(8, 4)
  hourlyRate               Decimal         @default(0) @map("hourly_rate") @db.Decimal(12, 2)
  travelTimeMinutes        Int             @default(0) @map("travel_time_minutes")
  travelCharge             Decimal         @default(0) @map("travel_charge") @db.Decimal(12, 2)
  // { name, dataUrl, signedAt }; dataUrl becomes a Storage path later (§7)
  customerSignature        Json?           @map("customer_signature")
  followUpRecommended      Boolean?        @map("follow_up_recommended")
  followUpNotes            String?         @map("follow_up_notes")
  arrivalTime              DateTime?       @map("arrival_time") @db.Timestamptz
  completionTime           DateTime?       @map("completion_time") @db.Timestamptz
  slaDueAt                 DateTime?       @map("sla_due_at") @db.Timestamptz // response deadline from the site's contract; breached while still `new` after it
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz
  isDeleted                Boolean         @default(false) @map("is_deleted")
  deletedAt                DateTime?       @map("deleted_at") @db.Timestamptz
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  equipment        JobEquipment[]
  partsUsed        JobPartUsed[]
  refrigerantLogs  RefrigerantLog[]
  checklist        JobChecklistItem[]
  auditLog         JobAuditLog[]
  photos           JobPhoto[]
  serviceRecords   EquipmentServiceRecord[]
  convertedRequest ServiceRequest?          @relation("RequestConvertedJob")
  quotations       Quotation[]              @relation("QuotationJob")
  quotationsFrom   Quotation[]              @relation("QuotationConvertedJob")
  invoices         Invoice[]
  movements        InventoryMovement[]

  @@unique([companyId, legacyId])
  @@unique([companyId, jobNumber])
  @@index([technicianId, appointmentDate])
  @@index([status])
  @@index([companyId])
  @@map("jobs")
}

model JobEquipment {
  jobId       String    @map("job_id") @db.Uuid
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  equipmentId String    @map("equipment_id") @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@id([jobId, equipmentId])
  @@map("job_equipment")
}

model RefrigerantLog {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  equipmentId String?  @map("equipment_id") @db.Uuid
  refrigerant String
  action      String
  amountKg    Decimal  @map("amount_kg") @db.Decimal(8, 3)
  cylinderId  String   @default("") @map("cylinder_id")
  certNumber  String   @map("cert_number")
  notes       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("refrigerant_logs")
}

model JobPartUsed {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partId    String?  @map("part_id") @db.Uuid
  part      Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  partName  String   @map("part_name")
  sku       String   @default("")
  quantity  Int
  unitCost  Decimal  @map("unit_cost") @db.Decimal(12, 2)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("job_parts_used")
}

model JobChecklistItem {
  id       String            @id @default(uuid()) @db.Uuid
  jobId    String            @map("job_id") @db.Uuid
  job      Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label    String
  category ChecklistCategory
  checked  Boolean           @default(false)
  notes    String?
  position Int               @default(0)

  @@index([jobId])
  @@map("job_checklist_items")
}

// Append-only; actor comes from the token
model JobAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  action    String
  details   String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("job_audit_log")
}

model Quotation {
  id                   String          @id @default(uuid()) @db.Uuid
  companyId            String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company              Company         @relation(fields: [companyId], references: [id])
  legacyId             String?         @map("legacy_id")
  quoteNumber          String          @map("quote_number")
  customerId           String          @map("customer_id") @db.Uuid
  customer             Customer        @relation(fields: [customerId], references: [id])
  locationId           String          @map("location_id") @db.Uuid
  location             ServiceLocation @relation(fields: [locationId], references: [id])
  jobId                String?         @map("job_id") @db.Uuid
  job                  Job?            @relation("QuotationJob", fields: [jobId], references: [id])
  issueDate            DateTime        @map("issue_date") @db.Date
  expiryDate           DateTime        @map("expiry_date") @db.Date
  status               QuotationStatus @default(draft)
  subtotal             Decimal         @db.Decimal(12, 2)
  vatRatePercent       Decimal         @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount            Decimal         @map("vat_amount") @db.Decimal(12, 2)
  total                Decimal         @db.Decimal(12, 2)
  terms                String          @default("")
  notes                String?
  acceptedAt           DateTime?       @map("accepted_at") @db.Timestamptz
  acceptedBy           String?         @map("accepted_by")
  acceptedSignature    String?         @map("accepted_signature")
  approvalTokenHash    String?         @unique @map("approval_token_hash")
  convertedToJobId     String?         @map("converted_to_job_id") @db.Uuid
  convertedToJob       Job?            @relation("QuotationConvertedJob", fields: [convertedToJobId], references: [id])
  convertedToInvoiceId String?         @unique @map("converted_to_invoice_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  isDeleted            Boolean         @default(false) @map("is_deleted")
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  items            LineItem[]
  convertedInvoice Invoice?   @relation("QuotationConvertedInvoice", fields: [convertedToInvoiceId], references: [id])
  invoices         Invoice[]  @relation("InvoiceQuote")

  @@unique([companyId, legacyId])
  @@unique([companyId, quoteNumber])
  @@index([status, expiryDate])
  @@index([companyId])
  @@map("quotations")
}

model Invoice {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company          Company         @relation(fields: [companyId], references: [id])
  legacyId         String?         @map("legacy_id")
  invoiceNumber    String          @map("invoice_number")
  quoteId          String?         @map("quote_id") @db.Uuid
  quote            Quotation?      @relation("InvoiceQuote", fields: [quoteId], references: [id])
  jobId            String?         @map("job_id") @db.Uuid
  job              Job?            @relation(fields: [jobId], references: [id])
  customerId       String          @map("customer_id") @db.Uuid
  customer         Customer        @relation(fields: [customerId], references: [id])
  locationId       String          @map("location_id") @db.Uuid
  location         ServiceLocation @relation(fields: [locationId], references: [id])
  issueDate        DateTime        @map("issue_date") @db.Date
  dueDate          DateTime        @map("due_date") @db.Date
  status           InvoiceStatus   @default(draft)
  subtotal         Decimal         @db.Decimal(12, 2)
  vatRatePercent   Decimal         @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount        Decimal         @map("vat_amount") @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  amountPaid       Decimal         @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue       Decimal         @map("balance_due") @db.Decimal(12, 2)
  paymentTermsDays Int             @default(30) @map("payment_terms_days")
  notes            String?
  reverseCharge    Boolean         @default(false) @map("reverse_charge") // domestic reverse charge: no VAT charged, customer accounts for it
  cisRatePercent   Decimal         @default(0) @map("cis_rate_percent") @db.Decimal(5, 2) // CIS rate the customer deducts from labour (0/20/30)
  cisDeduction     Decimal         @default(0) @map("cis_deduction") @db.Decimal(12, 2)
  retentionPercent Decimal         @default(0) @map("retention_percent") @db.Decimal(5, 2)
  retentionHeld    Decimal         @default(0) @map("retention_held") @db.Decimal(12, 2) // withheld from balanceDue until released
  stageLabel       String?         @map("stage_label") // deposit / stage / final invoice raised from a quote
  stagePercent     Decimal?        @map("stage_percent") @db.Decimal(5, 2) // share of the quote this stage bills
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  isDeleted        Boolean         @default(false) @map("is_deleted")
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  items       LineItem[]
  payments    Payment[]
  creditNotes CreditNote[]
  fromQuote   Quotation?   @relation("QuotationConvertedInvoice")

  @@unique([companyId, legacyId])
  @@unique([companyId, invoiceNumber])
  @@index([status, dueDate])
  @@index([companyId])
  @@map("invoices")
}

// Shared by quotations and invoices; exactly one parent is set
model LineItem {
  vatRatePercent Decimal?     @map("vat_rate_percent") @db.Decimal(5, 2)
  id             String       @id @default(uuid()) @db.Uuid
  quotationId    String?      @map("quotation_id") @db.Uuid
  quotation      Quotation?   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  invoiceId      String?      @map("invoice_id") @db.Uuid
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type           LineItemType
  description    String
  quantity       Decimal      @db.Decimal(10, 4)
  unitPrice      Decimal      @map("unit_price") @db.Decimal(12, 2)
  amount         Decimal      @db.Decimal(12, 2)
  position       Int          @default(0)
  option         String?

  @@index([quotationId])
  @@index([invoiceId])
  @@map("line_items")
}

// Append-only
model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  legacyId   String?       @unique @map("legacy_id")
  invoiceId  String        @map("invoice_id") @db.Uuid
  invoice    Invoice       @relation(fields: [invoiceId], references: [id])
  date       DateTime      @db.Date
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  reference  String        @default("")
  recordedBy String        @map("recorded_by")
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  refunded   Boolean       @default(false)

  @@index([invoiceId])
  @@map("payments")
}

model CreditNote {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id])
  creditNumber String   @map("credit_number")
  invoiceId    String   @map("invoice_id") @db.Uuid
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  amount       Decimal  @db.Decimal(12, 2)
  reason       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String   @map("created_by")
  vatAmount    Decimal  @default(0) @map("vat_amount") @db.Decimal(12, 2)

  @@unique([companyId, creditNumber])
  @@index([invoiceId])
  @@index([companyId])
  @@map("credit_notes")
}

model Part {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company       Company   @relation(fields: [companyId], references: [id])
  legacyId      String?   @map("legacy_id")
  name          String
  sku           String
  description   String    @default("")
  category      String    @default("")
  unitCost      Decimal   @map("unit_cost") @db.Decimal(12, 2)
  sellingPrice  Decimal   @map("selling_price") @db.Decimal(12, 2)
  // CHECK (stock_quantity >= 0) added in migration SQL
  stockQuantity Int       @default(0) @map("stock_quantity")
  minStockLevel Int       @default(0) @map("min_stock_level")
  location      String    @default("")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  inactive      Boolean   @default(false)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  movements InventoryMovement[]
  jobParts  JobPartUsed[]

  @@unique([companyId, legacyId])
  @@unique([companyId, sku])
  @@index([companyId])
  @@map("parts")
}

// Append-only ledger; parts.stock_quantity changes only alongside a row here, in one tx
model InventoryMovement {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company       Company      @relation(fields: [companyId], references: [id])
  legacyId      String?      @map("legacy_id")
  partId        String       @map("part_id") @db.Uuid
  part          Part         @relation(fields: [partId], references: [id])
  type          MovementType
  quantityDelta Int          @map("quantity_delta")
  jobId         String?      @map("job_id") @db.Uuid
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  notes         String       @default("")
  userName      String       @map("user_name")
  vatAmount     Decimal      @default(0) @map("vat_amount") @db.Decimal(12, 2)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([companyId, legacyId])
  @@index([partId])
  @@index([companyId])
  @@map("inventory_movements")
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company     Company             @relation(fields: [companyId], references: [id])
  legacyId    String?             @map("legacy_id")
  customerId  String              @map("customer_id") @db.Uuid
  customer    Customer            @relation(fields: [customerId], references: [id])
  type        NotificationType
  recipient   String
  channel     NotificationChannel
  subject     String
  messageBody String              @map("message_body")
  invoiceId   String?             @map("invoice_id") @db.Uuid // attach this invoice\'s PDF when sending
  quotationId String?             @map("quotation_id") @db.Uuid // attach this quotation\'s PDF when sending
  status      NotificationStatus  @default(draft)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz
  approvedBy  String?             @map("approved_by")
  claimedAt   DateTime?           @map("claimed_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@unique([companyId, legacyId])
  @@index([status])
  @@index([companyId])
  @@map("customer_notifications")
}

// Replay guard for the offline write queue: one row per (user, x-idempotency-key); status/body null while the first attempt runs
model IdempotencyKey {
  key         String
  userId      String   @map("user_id")
  fingerprint String   @default("")
  status      Int?
  body        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([key, userId])
  @@map("idempotency_keys")
}

// Admin-managed checklist items offered per job type (copied onto a job when added)
model ChecklistTemplate {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company   Company           @relation(fields: [companyId], references: [id])
  jobType   JobType           @map("job_type")
  label     String
  category  ChecklistCategory @default(general)
  position  Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  isDeleted Boolean           @default(false) @map("is_deleted")
  deletedAt DateTime?         @map("deleted_at") @db.Timestamptz
  inactive  Boolean           @default(false)

  @@index([jobType])
  @@index([companyId])
  @@map("checklist_templates")
}

// Append-only trail for money and compliance actions outside jobs (jobs have JobAuditLog).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  entity    String
  entityId  String   @map("entity_id")
  action    String
  details   String   @default("")
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entity, entityId])
  @@index([companyId])
  @@map("audit_log")
}

// Recurring preventive-maintenance contract: the daily sweep raises a job when nextDueDate is near.
model MaintenanceAgreement {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company          Company   @relation(fields: [companyId], references: [id])
  customerId       String    @map("customer_id") @db.Uuid
  locationId       String    @map("location_id") @db.Uuid
  equipmentId      String?   @map("equipment_id") @db.Uuid
  frequency        String
  nextDueDate      DateTime  @map("next_due_date") @db.Date
  active           Boolean   @default(true)
  notes            String?
  annualPrice      Decimal   @default(0) @map("annual_price") @db.Decimal(12, 2) // ex-VAT; each visit bills its share when autoInvoice is on
  endDate          DateTime? @map("end_date") @db.Date // term end: no visits are raised after it and the agreement deactivates
  slaResponseHours Int?      @map("sla_response_hours") // promised response time for call-outs; informational
  autoInvoice      Boolean   @default(false) @map("auto_invoice")
  autoRenew        Boolean   @default(false) @map("auto_renew") // past endDate, extend the term 12 months instead of deactivating
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([active, nextDueDate])
  @@index([companyId])
  @@map("maintenance_agreements")
}

// Gas Safe paperwork. Engineer name/licence are snapshotted at issue so later profile edits can't alter a signed certificate.
model Certificate {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company       Company         @relation(fields: [companyId], references: [id])
  certNumber    String          @map("cert_number")
  type          CertificateType
  jobId         String?         @map("job_id") @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  locationId    String          @map("location_id") @db.Uuid
  technicianId  String          @map("technician_id") @db.Uuid
  engineerName  String          @map("engineer_name")
  gasSafeNumber String          @map("gas_safe_number")
  issueDate     DateTime        @map("issue_date") @db.Date
  expiryDate    DateTime?       @map("expiry_date") @db.Date
  data          Json
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  isDeleted     Boolean         @default(false) @map("is_deleted")
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz

  @@unique([companyId, certNumber])
  @@index([customerId])
  @@index([jobId])
  @@index([expiryDate])
  @@index([companyId])
  @@map("certificates")
}

// Site photos. Bytes live in Postgres (client compresses to WebP, max 600KB); move to object storage if volume grows.
model JobPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  caption   String   @default("")
  takenBy   String   @map("taken_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("job_photos")
}

// A tenant: every business row below carries company_id, and login is (company slug, email, password).
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique // what the user types at login, stored lowercase
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  settings              CompanySettings?
  counters              Counter[]
  users                 User[]
  technicians           Technician[]
  customers             Customer[]
  serviceLocations      ServiceLocation[]
  equipments            Equipment[]
  serviceRequests       ServiceRequest[]
  jobs                  Job[]
  quotations            Quotation[]
  invoices              Invoice[]
  creditNotes           CreditNote[]
  parts                 Part[]
  inventoryMovements    InventoryMovement[]
  notifications         Notification[]
  checklistTemplates    ChecklistTemplate[]
  auditLogs             AuditLog[]
  maintenanceAgreements MaintenanceAgreement[]
  certificates          Certificate[]

  @@map("companies")
}
