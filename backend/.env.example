NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
# Supabase (spec section 12.3). Set SUPABASE_JWT_SECRET or SUPABASE_JWKS_URL to verify tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Run daily sweeps + notification delivery inside the API process (set false once a separate worker runs)
WORKER_INLINE=true

# Session cookies are Secure outside APP_ENV=local. Use none only if the web app and API are on different sites (HTTPS required).
# COOKIE_SAMESITE=lax
